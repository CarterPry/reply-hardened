<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for the group-chat opener: without this key macOS
	     auto-denies Apple Events silently (error -1743) and the app
	     never appears in Settings → Privacy & Security → Automation. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>Reply Hardened opens conversations by driving the Messages search field.</string>
</dict>
</plist>
